generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// NextAuth.js required models
// ============================================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================
// Core User model
// ============================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          String?   // "creator" or "brand"
  onboardingCompleted Boolean @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts       Account[]
  sessions       Session[]
  creatorProfile CreatorProfile?
  brandProfile   BrandProfile?
  reviewsGiven   Review[]  @relation("ReviewerReviews")
  reviewsReceived Review[] @relation("RevieweeReviews")
}

// ============================================
// Creator Profile
// ============================================

model CreatorProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  displayName     String
  bio             String?  @db.Text
  instagramHandle String
  city            String
  niches          String[]
  followerCount   Int?
  engagementRate  Float?
  rateMin         Int      @default(500)
  rateMax         Int      @default(5000)
  portfolioUrls   String[]
  avgRating       Float    @default(0)
  totalDeals      Int      @default(0)
  totalEarnings   Int      @default(0)
  level           String   @default("bronze") // bronze, silver, gold, platinum
  verified        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications Application[]
  deals        Deal[]        @relation("CreatorDeals")

  @@index([city])
  @@index([avgRating(sort: Desc)])
}

// ============================================
// Brand Profile
// ============================================

model BrandProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  businessName    String
  category        String
  description     String?  @db.Text
  city            String
  gstNumber       String?
  website         String?
  instagramHandle String?
  logoUrl         String?
  avgRating       Float    @default(0)
  totalCampaigns  Int      @default(0)
  totalSpent      Int      @default(0)
  verified        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaigns Campaign[]
  deals     Deal[]     @relation("BrandDeals")

  @@index([city])
}

// ============================================
// Campaign
// ============================================

model Campaign {
  id                String   @id @default(cuid())
  brandId           String
  title             String
  description       String   @db.Text
  city              String
  niches            String[]
  contentType       String
  budgetPerCreator  Int
  maxCreators       Int      @default(5)
  deadline          DateTime
  status            String   @default("active") // draft, active, paused, completed
  applicationsCount Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  brand        BrandProfile  @relation(fields: [brandId], references: [id], onDelete: Cascade)
  applications Application[]
  deals        Deal[]

  @@index([city])
  @@index([niches])
  @@index([status])
  @@index([createdAt(sort: Desc)])
}

// ============================================
// Application
// ============================================

model Application {
  id         String   @id @default(cuid())
  campaignId String
  creatorId  String
  pitchText  String   @db.Text
  status     String   @default("pending") // pending, accepted, rejected
  appliedAt  DateTime @default(now())

  campaign Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  creator  CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@unique([campaignId, creatorId])
  @@index([campaignId])
  @@index([creatorId])
}

// ============================================
// Deal (with escrow tracking)
// ============================================

model Deal {
  id                String    @id @default(cuid())
  campaignId        String
  brandId           String
  creatorId         String
  amount            Int
  platformFee       Int
  escrowStatus      String    @default("pending") // pending, escrow_held, content_submitted, revision_requested, approved, released, refunded, disputed
  contentUrl        String?
  proofScreenshots  String[]
  revisionRequested Boolean   @default(false)
  brandApproved     Boolean   @default(false)
  completedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  campaign Campaign       @relation(fields: [campaignId], references: [id])
  brand    BrandProfile   @relation("BrandDeals", fields: [brandId], references: [id])
  creator  CreatorProfile @relation("CreatorDeals", fields: [creatorId], references: [id])
  reviews  Review[]

  @@unique([campaignId, creatorId]) // Prevent duplicate deals
  @@index([brandId])
  @@index([creatorId])
  @@index([campaignId])
  @@index([escrowStatus])
}

// ============================================
// Review (dual-sided)
// ============================================

model Review {
  id         String   @id @default(cuid())
  dealId     String
  reviewerId String
  revieweeId String
  rating     Int      // 1-5
  comment    String?  @db.Text
  createdAt  DateTime @default(now())

  deal     Deal @relation(fields: [dealId], references: [id])
  reviewer User @relation("ReviewerReviews", fields: [reviewerId], references: [id])
  reviewee User @relation("RevieweeReviews", fields: [revieweeId], references: [id])

  @@unique([dealId, reviewerId])
}

// ============================================
// Notification
// ============================================

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   // application_received, application_accepted, application_rejected, deal_updated, review_received, campaign_expired
  title     String
  message   String   @db.Text
  read      Boolean  @default(false)
  linkUrl   String?  // Optional link to navigate to
  metadata  String?  @db.Text // JSON string for extra data
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, read])
  @@index([createdAt(sort: Desc)])
}
